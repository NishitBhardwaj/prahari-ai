# Prahari AI Backend — Environment Template
# Copy to .env and fill in values before running

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key

# ── PostgreSQL (PostGIS) ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/prahari

# ── Neo4j AuraDB ──────────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://your-aura-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ── Qdrant ────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Zoho Catalyst ─────────────────────────────────────────────────────────
CATALYST_PROJECT_ID=your-project-id
CATALYST_PROJECT_KEY=your-project-key
CATALYST_ACCOUNT_ID=your-account-id
CATALYST_AUTH_DOMAIN=accounts.zoho.com
CATALYST_STRATUS_BUCKET=prahari-media
CATALYST_CACHE_SEGMENT=prahari-cache

# ── Google Gemini ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://prahari-frontend.catalyst.zoho.com
